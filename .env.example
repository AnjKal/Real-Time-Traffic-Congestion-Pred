# Copy this file to .env and fill in your own values. Do NOT commit .env.
# Nothing here is required for the offline/dev mode; the defaults below run with no AWS account.

# --------------------------------------------------------------------------- data sources
# TomTom API key used by the collector (pipeline service only; not needed by the web app).
TOMTOM_API_KEY=your_key_here
# Kafka broker used by the pipeline, journey agent and incident agent when running the live stack.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Model service the web app and the interaction agent read forecasts/health from.
MODEL_SERVICE_URL=http://127.0.0.1:8001

# --------------------------------------------------------------------------- interaction agent
# The User Interaction Agent (Phase 4). All values are optional; these are the built-in defaults
# from webapp/interaction_agent/config.py, shown so they are discoverable.

# LLM provider for the conversational agent: "mock" (deterministic, no AWS, the development
# default) or "bedrock" (Amazon Bedrock Converse; see the AWS block below).
INTERACTION_LLM_PROVIDER=mock
# Timeout in seconds for the interaction agent's model-service /health call.
INTERACTION_REQUEST_TIMEOUT=10
# Published data older than this many minutes is reported as stale, never as current. Also the
# freshness window used when generating proactive notifications.
INTERACTION_STALE_AFTER_MIN=10

# Conversation memory (sessions + messages), stored in the shared interaction database. Leave the
# path unset to use <project root>/data/live/interaction_memory.sqlite.
INTERACTION_MEMORY_ENABLED=true
INTERACTION_MEMORY_MAX_MESSAGES=20
# INTERACTION_MEMORY_DB_PATH=data/live/interaction_memory.sqlite

# Proactive notifications: a background poller in the web app turns freshly published incidents and
# journey decisions into alerts for the journeys a session has explicitly subscribed to.
INTERACTION_NOTIFICATIONS_ENABLED=true
# Do not re-notify the same journey/topic sooner than this (a severity escalation breaks through).
INTERACTION_NOTIFICATION_COOLDOWN_MIN=10
# How often the notification runtime runs a cycle, in seconds (matches the model's poll cadence).
INTERACTION_NOTIFICATION_POLL_INTERVAL_S=120

# --------------------------------------------------------------------------- Amazon Bedrock
# Only used when INTERACTION_LLM_PROVIDER=bedrock. Credentials are NOT set here: boto3 resolves
# them from the standard chain (environment variables, shared config, instance role).
AWS_REGION=ap-south-1
# A plain model id, an inference-profile id, or an inference-profile ARN all work here. Nova Lite is
# the default; verify that the model and (if required) its inference profile are available in your
# region after the AWS account is approved -- availability is not assumed.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1024
# Sampling temperature (0..1). Low by default so answers stay grounded in the tool results.
BEDROCK_TEMPERATURE=0.2
# Connection and read timeouts, in seconds, for the bedrock-runtime client.
BEDROCK_CONNECT_TIMEOUT=5
BEDROCK_READ_TIMEOUT=30
# Bounded SDK retries for throttling / transient 5xx (0 disables retries).
BEDROCK_MAX_RETRIES=3
