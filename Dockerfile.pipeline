FROM python:3.7-slim

WORKDIR /app
COPY requirements.txt requirements_pipeline.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements_pipeline.txt
COPY . .

ENV KAFKA_BOOTSTRAP_SERVERS=kafka:29092 PYTHONUNBUFFERED=1
CMD ["python", "start_pipeline.py", "--step-min", "2", "--host", "0.0.0.0", "--port", "8001", "--kafka-bootstrap", "kafka:29092"]
